{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advanced-analysis.invalid/schemas/topology-edit/qualification-evidence-schema.json",
  "title": "Topology Edit Qualification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "commit",
    "sourceRepository",
    "sourceCommit",
    "manifestHash",
    "behaviorDispositionHash",
    "testCommand",
    "startedAt",
    "completedAt",
    "status",
    "runtime",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "TopologyEditQualificationEvidence.v1"
    },
    "repository": {
      "const": "reallaksh19/Advanced_Analysis"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceRepository": {
      "const": "reallaksh19/XML_Compare_Utilities"
    },
    "sourceCommit": {
      "const": "c20bb037566d52ba5b789712594b754a5fb94651"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "behaviorDispositionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "testCommand": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "platform",
        "arch",
        "ci"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "ci": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  }
}
